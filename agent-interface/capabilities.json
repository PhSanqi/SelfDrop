{
  "name": "selfdrop-local-agent-gateway",
  "version": 2,
  "sourceOfTruth": "agent-interface/README.md",
  "commandPrefix": ["npm", "run", "agent", "--"],
  "capabilities": {
    "list": {
      "description": "List file objects currently available in the bound SelfDrop instance.",
      "arguments": [],
      "outputFileArray": "result.files"
    },
    "pull": {
      "description": "Download one SelfDrop file by fileId to an explicitly controlled local path.",
      "arguments": ["fileId"],
      "options": ["--dir", "--out", "--force"],
      "defaultDirectory": "platform-default",
      "windowsDefaultDirectory": "%LOCALAPPDATA%\\SelfDrop\\downloads",
      "linuxDefaultDirectory": "~/.local/share/selfdrop-agent/downloads",
      "defaultOverwrite": false
    },
    "push": {
      "description": "Upload one explicitly selected local file to SelfDrop.",
      "arguments": ["path"],
      "options": ["--device"]
    }
  },
  "configuration": {
    "commands": ["init", "config"],
    "remoteMode": "cloudflare-access-user",
    "remoteEndpointMustBeBound": true,
    "remoteHttpsRequired": true,
    "windowsCloudflaredFallback": "%LOCALAPPDATA%\\SelfDrop\\bin\\cloudflared.exe"
  },
  "constraints": {
    "loopbackOnly": false,
    "singleBoundRemoteEndpoint": true,
    "deleteCapability": false,
    "browserAutomationRequired": false,
    "implicitWorkspaceUpload": false,
    "downloadImpliesUserConsumption": false
  }
}
